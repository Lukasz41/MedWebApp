@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var firstName = HttpContextAccessor?.HttpContext?.Session.GetString("FirstName");
    var role = HttpContextAccessor?.HttpContext?.Session.GetString("Role");
    bool isLoggedIn = !string.IsNullOrEmpty(firstName);
    bool isAdmin = role == "Admin";
    bool isPatient = role == "Patient";
    bool isDoctor = role == "Doctor";
}



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MedWebApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MedWebApp.styles.css" asp-append-version="true" />
    <style>
        nav {
            background-color: #d9fff7;
        }</style>




</head>
<body>
    
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">MedWebApp</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="btn btn-success me-2" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        
                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="btn btn-success me-2" asp-controller="Account" asp-action="AddDoctor">Add Doctor</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-success me-2" asp-action="DoctorList" asp-controller="Account">Manage Doctors</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-success me-2" asp-action="DoctorsDirectory" asp-controller="Account">View Doctors</a>
                            </li>
                        }
                        @if (isPatient)
                        {
                            <li class="nav-item">
                                <a class="btn btn-success me-2" asp-controller="Appointment" asp-action="Create">Book Appointment</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-success me-2" asp-controller="Appointment" asp-action="MyAppointments">My Appointments</a>
                            </li>
                        }
                        @if (isDoctor)
                        {
                            <li class="nav-item">
                                <a class="btn btn-success me-2" asp-controller="Appointment" asp-action="DoctorAppointments">Doctor Panel</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="btn btn-success me-2" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-success me-2" asp-area="" asp-controller="Home" asp-action="AboutUs">About Us</a>
                        </li>


                    </ul>

                    <ul class="navbar-nav">
                        @if (isLoggedIn)
                        {
                            <li class="nav-item">
                                <span class="nav-link">Welcome, @firstName!</span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-danger" asp-controller="Account" asp-action="Logout">Logout</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-primary me-2" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - MedWebApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
