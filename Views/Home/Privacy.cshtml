@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container mt-4">
    <h1 class="mb-4">Privacy Policy</h1>

    <p>
        At <strong>MedWebApp Clinic</strong>, we take your privacy seriously. This policy explains how we collect, use, and protect your personal information when you use our website and services.
    </p>

    <h3 class="mt-4">What Information We Collect</h3>
    <p>When you register or book an appointment, we may collect:</p>
    <ul>
        <li>Full Name</li>
        <li>Contact Details (Email, Phone, Address)</li>
        <li>Date of Birth</li>
    </ul>

    <h3 class="mt-4">How We Use Your Information</h3>
    <p>We use your data only to:</p>
    <ul>
        <li>Manage appointments and healthcare services</li>
        <li>Contact you regarding bookings or important updates</li>
        <li>Ensure your experience with our clinic is smooth and personalized</li>
    </ul>

    <h3 class="mt-4">How We Protect Your Data</h3>
    <p>
        All personal information is stored securely and is only accessible by authorized staff. We do not sell, rent, or share your data with third parties.
    </p>

    <h3 class="mt-4">Your Rights</h3>
    <p>
        You have the right to access, correct, or request deletion of your data. To do so, please contact our clinic team.
    </p>

    <h3 class="mt-4">Contact Us</h3>
    <p>
        If you have questions about this policy, reach out to us at <a href="mailto:privacy@medwebapp.com">privacy@medwebapp.com</a>.
    </p>
</div>
