@model List<MedWebApp.Models.User>

<h2>Manage Doctors</h2>

<table class="table table-bordered">
    

    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>DOB</th>
            <th>Address</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var doctor in Model)
        {
            <tr>
                <td>@doctor.FirstName @doctor.LastName</td>
                <td>@doctor.Email</td>
                <td>@doctor.Phone</td>
                <td>@doctor.DOB.ToShortDateString()</td>
                <td>@doctor.Street, @doctor.City, @doctor.Postcode</td>
                <td>
                    <a class="btn btn-sm btn-primary" asp-action="EditDoctor" asp-route-id="@doctor.UserId">Edit</a>

                    <form asp-action="DeleteDoctor" asp-route-id="@doctor.UserId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to permanently delete Dr. @doctor.FirstName @doctor.LastName?');">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
